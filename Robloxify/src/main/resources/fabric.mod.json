{
  "schemaVersion": 1,
  "id": "robloxify",
  "version": "${version}",
  "name": "Robloxify",
  "description": "A progressive fusion of Minecraft and Roblox: blocky avatars, Robux, badges, experiences, obbies and a few very suspicious NPCs.",
  "authors": [
    "Robloxify"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/robloxify/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.robloxify.Robloxify"
    ],
    "client": [
      "com.robloxify.RobloxifyClient"
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
